{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":enablePreCommit"
  ],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "description": "Upstream pins gate on the Component's Contract Tests; never automerge them",
      "matchFileNames": [
        "components/*/upstreams.yaml"
      ],
      "automerge": false,
      "addLabels": [
        "contract-pin"
      ]
    },
    {
      "description": "backup-coverage ships the restic it runs Contract Tests against: bump the Dockerfile and upstreams.yaml pins together",
      "matchFileNames": [
        "components/backup-coverage/Dockerfile",
        "components/backup-coverage/upstreams.yaml"
      ],
      "matchPackageNames": [
        "restic/restic"
      ],
      "groupName": "backup-coverage restic"
    },
    {
      "description": "cwa-ingest-gate builds on the Calibre-Web Automated image it runs Contract Tests against: bump the Dockerfile and upstreams.yaml pins together",
      "matchFileNames": [
        "components/cwa-ingest-gate/Dockerfile",
        "components/cwa-ingest-gate/upstreams.yaml"
      ],
      "matchPackageNames": [
        "crocodilestick/calibre-web-automated"
      ],
      "groupName": "cwa-ingest-gate calibre-web-automated"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Upstream images pinned for Contract Tests (components/<name>/upstreams.yaml)",
      "managerFilePatterns": [
        "/(^|/)upstreams\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*\"?(?<depName>[^\\s:@\"]+(?::\\d+/[^\\s:@\"]+)?):(?<currentValue>[^\\s@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\"?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Versions annotated with # renovate: comments in workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ]
}
